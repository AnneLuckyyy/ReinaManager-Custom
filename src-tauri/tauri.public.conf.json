{
	"productName": "ReinaManager Custom",
	"version": "0.20.5-custom.1",
	"identifier": "io.github.anneluckyyy.reinamanager-custom",
	"mainBinaryName": "ReinaManagerCustom",
	"app": {
		"windows": [
			{
				"title": "ReinaManager Custom",
				"width": 1200,
				"height": 720,
				"minWidth": 1024,
				"minHeight": 640,
				"resizable": true,
				"fullscreen": false,
				"dragDropEnabled": true,
				"visible": false
			}
		]
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"resources": {
			"../LICENSE": "LICENSE",
			"../NOTICE.md": "NOTICE.md",
			"target/7zip/": "tools/7zip"
		},
		"licenseFile": "../LICENSE",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"nsis": {
				"installerIcon": "icons/icon.ico",
				"languages": [
					"English",
					"SimpChinese",
					"TradChinese",
					"Japanese"
				],
				"displayLanguageSelector": true
			}
		},
		"createUpdaterArtifacts": false,
		"publisher": "AnneLucky",
		"copyright": "Copyright © 2025 huoshen80; modified edition © 2026 AnneLucky",
		"homepage": "https://github.com/AnneLuckyyy/ReinaManager-Custom",
		"category": "Game"
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": [
					"reinamanager-custom"
				]
			}
		}
	}
}
